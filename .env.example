
# Discord Bot Token
DISCORD_BOT_TOKEN=

# Discord Channel ID
DISCORD_CHANNEL_ID=

# ==========================================
# Optional Variables

# 操作を許可するユーザーID
# DISCORD_USER_ID=

# メインセッションの作業ディレクトリ（デフォルト: ~/Desktop）
# DEFAULT_CWD=~/Desktop

# 事前許可するツール（カンマ区切り、例: Bash(ls*),Read,Glob）
# ALLOWED_TOOLS=
